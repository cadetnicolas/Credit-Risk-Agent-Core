# credit-risk-agent 环境变量模板
#
# 先看这里：如果你只是想连一个数据库，**不要手写这个文件**。
#   运行  python scripts/config_setup.py
# 会生成一个本地页面 ~/.credit-agent/setup.html，在浏览器里填表、点保存即可。
# 页面填出来的配置优先级高于本文件，两者不必同时使用。
#
# 本文件适合：写进部署脚本、CI、或一次维护多套环境。
#
# 用法：cp .env.example .env 后填入本地/生产值，然后 chmod 600 .env。
# .env 不入库（上级 .gitignore 已覆盖），凭证只允许来自环境变量，代码中严禁硬编码。
# 本文件只给出变量名与说明，所有值留空，不包含任何真实凭证。
# 参考：docs/integration.md（跨平台接入与凭证优先级）、
#       docs/workbuddy-install-and-usage.md 第 2.1 节（WorkBuddy 下的完整配置指南）、
#       docs/sample-acquisition-design.md（取数链路）。
#
# 加载规则（v0.4 起生效）：
#   1. 进程环境变量优先，.env 只补空缺，覆盖不了 mcp.json 里已写的值；
#   2. 查找顺序：$CREDIT_AGENT_ENV_FILE → <进程工作目录>/.env → ~/.credit-agent/.env；
#   3. MCP 服务的工作目录是仓库根，所以 .env 放在仓库根最省事；
#   4. CREDIT_AGENT_SKIP_DOTENV=1 可整体关闭 .env 加载（测试用）。
# 优先级从高到低：mcp.json 的 env 段 > 配置页 > 本文件 > 内置默认值。
# 配完先自检：python scripts/check_db.py --list-tables

# --- 驱动（装一次即可，与配置无关）------------------------------------------
# 只有 duckdb 是基础依赖；其余后端各需一个驱动：
#   odps      -> pip install pyodps
#   postgres  -> pip install psycopg2-binary
#   holo      -> pip install psycopg2-binary      （Hologres 走 PG 协议）
#   mysql     -> pip install pymysql
# 一次装全：pip install -e ".[warehouse]"
# 驱动没装时 scripts/check_db.py 会直接告诉你缺哪个，不会误报成"密码错误"。

# --- 数据后端 ---------------------------------------------------------------
# 可选值：duckdb（离线 / 本地等价数据）、odps（MaxCompute）、
#         postgres、holo（Hologres）、mysql。
# 同一条 SQL 在 duckdb/postgres/holo/mysql 上原样可跑；odps 需 MaxCompute 语法。
# 未配置时使用 duckdb。
CREDIT_AGENT_DATA_BACKEND=

# 单次下载/查询的行数上限，缺省 2000000（200 万行）。
# 注意：这不是隐私管控，而是防止一次手滑把生产表拉空、把本地磁盘写满。
CREDIT_AGENT_MAX_SCAN_ROWS=
# 建立数据库连接的超时秒数，缺省 30。
CREDIT_AGENT_CONNECT_TIMEOUT=

# --- 上传限制 ---------------------------------------------------------------
# 上传文件体积上限（MB），缺省 50。
CREDIT_AGENT_UPLOAD_MAX_MB=
# 上传文件行数上限，缺省 2000000（200 万行）。
CREDIT_AGENT_UPLOAD_MAX_ROWS=

# --- ODPS / MaxCompute 凭证 -------------------------------------------------
# 仅当 CREDIT_AGENT_DATA_BACKEND=odps 时需要。
# AccessKey 建议用只读 RAM 子账号，不要用主账号 AK。
# AccessKey ID
CREDIT_AGENT_ODPS_ACCESS_ID=
# AccessKey Secret
CREDIT_AGENT_ODPS_ACCESS_KEY=
# 可选，留空用公网默认 http://service.cn.maxcompute.aliyun.com/api。
# 内网 / 金融云 / 海外 Region 必须显式指定，否则连不上。
CREDIT_AGENT_ODPS_ENDPOINT=
# 项目空间（必填），如 opmgt_dev。
CREDIT_AGENT_ODPS_PROJECT=

# --- PostgreSQL / Hologres 凭证 ---------------------------------------------
# backend=postgres 或 backend=holo 时都需要这一段（Hologres 走 PostgreSQL 协议）。
# 端口留空时：postgres 用 5432，holo 用 80。
# Hologres 补充：database 填实例绑定的库名（常为 postgres 或项目名），
#               schema 建议显式填 public，否则每条 SQL 都要写全限定名。
CREDIT_AGENT_PG_HOST=
CREDIT_AGENT_PG_PORT=
CREDIT_AGENT_PG_DATABASE=
CREDIT_AGENT_PG_USER=
CREDIT_AGENT_PG_PASSWORD=
# 可选：disable / require / verify-ca / verify-full，留空由驱动决定。
CREDIT_AGENT_PG_SSLMODE=
# 可选：固定 search_path，省得每条 SQL 都写 public.xxx。
CREDIT_AGENT_PG_SCHEMA=

# --- MySQL / MariaDB 凭证 ---------------------------------------------------
# 仅当 CREDIT_AGENT_DATA_BACKEND=mysql 时需要。端口留空时用 3306。
CREDIT_AGENT_MYSQL_HOST=
CREDIT_AGENT_MYSQL_PORT=
CREDIT_AGENT_MYSQL_DATABASE=
CREDIT_AGENT_MYSQL_USER=
CREDIT_AGENT_MYSQL_PASSWORD=
# 缺省 utf8mb4（中文列名/中文值必须）。
CREDIT_AGENT_MYSQL_CHARSET=
